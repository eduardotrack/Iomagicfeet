{
  "header#faq": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Layout",
    "blocks": [
      "header-layout.desktop#faq",
      "header-layout.mobile#faq"
    ]
  },
  "header-layout.desktop#faq": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Layout desktop",
    "children": [
      "flex-layout.row#faq-header-root",
      "pd-canonicalAdvanced",
      "pd-ClearCep",
      "pd-ChangeTagLogin",
      "pd-popupNewsletter",
      "pd-remove-cancel-order",
      "pd-ColorsChanger#faq"
    ]
  },
  "header-layout.mobile#faq": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Layout mobile",
    "children": [
      "flex-layout.row#faq-header-root",
      "pd-canonicalAdvanced",
      "pd-ClearCep",
      "pd-ChangeTagLogin",
      "pd-popupNewsletter",
      "pd-remove-cancel-order",
      "pd-ColorsChanger#faq",
      "pd-MobileHeaderScrollControl",
      "pd-BlockZoomOnInput"
    ]
  },
  "pd-ColorsChanger#faq": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Cores do destaque do menu",
    "props": {
      "desktopTextColor": "#FE0000",
      "mobileBackgoundColor": "#1C1C1C",
      "mobileTextColor": "#E8E8E8"
    }
  },
  "flex-layout.col#faq-header-body": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Faixas e navegação",
    "props": {
      "blockClass": "faq-header-body",
      "preventVerticalStretch": true
    },
    "children": [
      "flex-layout.row#faq-header-top",
      "flex-layout.row#faq-header-desktop",
      "flex-layout.row#faq-header-mobile",
      "flex-layout.row#faq-header-cart"
    ]
  },
  "flex-layout.row#faq-header-root": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Estrutura",
    "props": {
      "blockClass": "faq-header-root",
      "fullWidth": true,
      "preventHorizontalStretch": false
    },
    "children": [
      "flex-layout.col#faq-header-body"
    ]
  },
  "rich-text#faq-header-description": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Texto da faixa superior",
    "props": {
      "blockClass": "faq-header-description",
      "text": "magicfeet: Roupas Infantis com Estilo da Cabeça aos Pés"
    }
  },
  "flex-layout.col#faq-header-description": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Descrição da loja",
    "props": {
      "blockClass": "faq-header-description",
      "preventVerticalStretch": true
    },
    "children": [
      "rich-text#faq-header-description"
    ]
  },
  "flex-layout.col#faq-header-shortcuts": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Atalhos institucionais",
    "props": {
      "blockClass": "faq-header-shortcuts",
      "preventVerticalStretch": true
    },
    "children": [
      "vtex.menu@2.x:menu#faq-header-shortcuts"
    ]
  },
  "flex-layout.row#faq-header-top": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Faixa superior",
    "props": {
      "blockClass": "faq-header-top",
      "fullWidth": true,
      "preventHorizontalStretch": false
    },
    "children": [
      "flex-layout.col#faq-header-description",
      "flex-layout.col#faq-header-shortcuts"
    ]
  },
  "vtex.menu@2.x:menu#faq-header-shortcuts": {
    "title": "Magic Feet | Atendimento · Cabeçalho · Links institucionais",
    "props": {
      "blockClass": "faq-header-shortcuts"
    },
    "children": [
      "menu-item#faq-header-franchise",
      "menu-item#faq-header-stores"
    ]
  },
  "menu-item#faq-header-franchise": {
    "title": "Magic Feet | Atendimento · Cabeçalho · seja um franqueado",
    "props": {
      "id": "faq-header-franchise",
      "type": "custom",
      "blockClass": [
        "faq-header-shortcut",
        "faq-header-franchise"
      ],
      "itemProps": {
        "type": "internal",
        "href": "/seja-franqueado",
        "tagTitle": "seja um franqueado",
        "text": "seja um franqueado"
      }
    }
  },
  "menu-item#faq-header-stores": {
