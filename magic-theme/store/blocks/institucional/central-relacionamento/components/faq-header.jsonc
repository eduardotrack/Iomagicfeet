  "search-bar#faq-desktop": {
    "props": {
      "placeholder": "o que você procura?",
      "openAutocompleteOnFocus": true,
      "blockClass": [
        "header__search",
        "faq-header-search-desktop"
      ],
      "displayMode": "search-button"
