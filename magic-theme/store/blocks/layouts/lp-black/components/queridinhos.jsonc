{
  "experimental__visibility-layout#bf26-queridinhos": {
    "title": "Vitrine Queridinhos - On/Off",
    "children": [
      "flex-layout.row#bf26-queridinhos"
    ],
    "props": {
      "visible": true
    }
  },

  // Seção: fundo verde-limão + foto à esquerda + painel (título, abas, slider) sobreposto à direita
  "flex-layout.row#bf26-queridinhos": {
    "title": "Vitrine Queridinhos - Container",
    "children": [
      "flex-layout.col#bf26-queridinhos"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-queridinhos"],
      "fullWidth": true
    }
  },

  "flex-layout.col#bf26-queridinhos": {
    "title": "Vitrine Queridinhos - Coluna",
    "children": ["flex-layout.row#bf26-queridinhos-body"],
    "props": {
      "blockClass": "lp-black-2k26-queridinhos-col"
    }
  },

  "flex-layout.row#bf26-queridinhos-body": {
    "title": "Vitrine Queridinhos - Foto + Painel",
    "children": [
      "image#bf26-queridinhos-photo",
      "flex-layout.col#bf26-queridinhos-panel"
    ],
    "props": {
      "blockClass": "lp-black-2k26-queridinhos-body"
    }
  },

  "image#bf26-queridinhos-photo": {
    "title": "Imagem de destaque",
    "props": {
      "src": "assets/img/lp-black/queridinhos-banner.jpg",
      "alt": "",
      "blockClass": "lp-black-2k26-queridinhos-photo"
    }
  },

  "flex-layout.col#bf26-queridinhos-panel": {
    "title": "Vitrine Queridinhos - Painel",
    "children": ["rich-text#bf26-queridinhos-title", "tab-layout#bf26-queridinhos"],
    "props": {
      "blockClass": "lp-black-2k26-queridinhos-panel"
    }
  },

  "rich-text#bf26-queridinhos-title": {
    "title": "Título",
    "props": {
      "text": "## os queridinhos da black friday",
      "blockClass": ["lp-black-2k26-title", "lp-black-2k26-queridinhos-title"]
    }
  },

  "tab-layout#bf26-queridinhos": {
    "children": ["tab-list#bf26-queridinhos", "tab-content#bf26-queridinhos"],
    "props": {
      "defaultActiveTabId": "fem",
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list#bf26-queridinhos": {
    "title": "Tab - Botões",
    "children": ["tab-list.item#bf26-queridinhos-fem", "tab-list.item#bf26-queridinhos-masc"],
    "props": {
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list.item#bf26-queridinhos-fem": {
    "title": "Tab - Feminino",
    "props": {
      "tabId": "fem",
      "label": "feminino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-list.item#bf26-queridinhos-masc": {
    "title": "Tab - Masculino",
    "props": {
      "tabId": "masc",
      "label": "masculino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-content#bf26-queridinhos": {
    "title": "Tab - Conteúdo",
    "children": ["tab-content.item#bf26-queridinhos-fem", "tab-content.item#bf26-queridinhos-masc"],
    "props": {
      "blockClass": "lp-black-2k26-tabs-content"
    }
  },

  // ---------- Feminino: cada card = imagem + link + marca + título (editáveis no Site Editor) ----------
  "tab-content.item#bf26-queridinhos-fem": {
    "title": "Conteúdo - Feminino",
    "children": ["slider-layout#bf26-queridinhos-fem"],
    "props": {
      "tabId": "fem",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "slider-layout#bf26-queridinhos-fem": {
    "title": "Slider - Feminino",
    "children": ["flex-layout.col#bf26-queridinhos-fem-1", "flex-layout.col#bf26-queridinhos-fem-2", "flex-layout.col#bf26-queridinhos-fem-3", "flex-layout.col#bf26-queridinhos-fem-4"],
    "props": {
      "itemsPerPage": { "desktop": 2, "tablet": 2, "phone": 1 },
      "infinite": false,
      "centerMode": { "desktop": "to-the-left", "tablet": "to-the-left", "phone": "to-the-left" },
      "centerModeSlidesGap": 8,
      "showNavigationArrows": "always",
      "showPaginationDots": "always",
      "blockClass": "lp-black-2k26-queridinhos"
    }
  },

  "flex-layout.col#bf26-queridinhos-fem-1": {
    "title": "Feminino - Card 1",
    "children": ["image#bf26-queridinhos-fem-1", "flex-layout.col#bf26-queridinhos-fem-1-text"],
    "props": {
      "blockClass": "lp-black-2k26-qcard"
    }
  },

  "image#bf26-queridinhos-fem-1": {
    "title": "Feminino - Card 1 - Imagem e link",
    "props": {
      "src": "assets/img/lp-black/queridinhos-1.jpg",
      "alt": "new balance samba og",
      "link": { "url": "/" },
      "blockClass": "lp-black-2k26-qcard"
    }
  },

  "flex-layout.col#bf26-queridinhos-fem-1-text": {
    "title": "Feminino - Card 1 - Textos",
    "children": ["rich-text#bf26-queridinhos-fem-1-brand", "rich-text#bf26-queridinhos-fem-1-title"],
    "props": {
      "blockClass": "lp-black-2k26-qcard-text"
    }
  },

  "rich-text#bf26-queridinhos-fem-1-brand": {
    "title": "Feminino - Card 1 - Marca",
    "props": {
      "text": "new balance",
      "blockClass": "lp-black-2k26-qcard-brand"
    }
  },

  "rich-text#bf26-queridinhos-fem-1-title": {
    "title": "Feminino - Card 1 - Título",
    "props": {
      "text": "samba og",
      "blockClass": "lp-black-2k26-qcard-title"
    }
  },

