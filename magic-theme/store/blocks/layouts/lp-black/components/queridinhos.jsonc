{
  "experimental__visibility-layout#bf26-queridinhos": {
    "title": "Vitrine Queridinhos - On/Off",
    "children": [
      "flex-layout.row#bf26-queridinhos"
    ],
    "props": {
      "visible": true
    }
  },

  "flex-layout.row#bf26-queridinhos": {
    "title": "Vitrine Queridinhos - Container",
    "children": [
      "flex-layout.col#bf26-queridinhos"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf", "lp-black-2k26-shelf--featured"],
      "fullWidth": true
    }
  },

  "flex-layout.col#bf26-queridinhos": {
    "title": "Vitrine Queridinhos - Coluna",
    "children": ["rich-text#bf26-queridinhos-title", "tab-layout#bf26-queridinhos"],
    "props": {
      "blockClass": "lp-black-2k26-shelf-col"
    }
  },

  "rich-text#bf26-queridinhos-title": {
    "title": "Título",
    "props": {
      "text": "## os queridinhos da black friday",
      "blockClass": ["lp-black-2k26-title", "lp-black-2k26-title--shelf"]
    }
  },

  "tab-layout#bf26-queridinhos": {
    "children": ["tab-list#bf26-queridinhos", "tab-content#bf26-queridinhos"],
    "props": {
      "defaultActiveTabId": "fem",
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list#bf26-queridinhos": {
    "title": "Tab - Botões",
    "children": ["tab-list.item#bf26-queridinhos-fem", "tab-list.item#bf26-queridinhos-masc"],
    "props": {
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list.item#bf26-queridinhos-fem": {
    "title": "Tab - Feminino",
    "props": {
      "tabId": "fem",
      "label": "feminino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-list.item#bf26-queridinhos-masc": {
    "title": "Tab - Masculino",
    "props": {
      "tabId": "masc",
      "label": "masculino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-content#bf26-queridinhos": {
    "title": "Tab - Conteúdo",
    "children": ["tab-content.item#bf26-queridinhos-fem", "tab-content.item#bf26-queridinhos-masc"],
    "props": {
      "blockClass": "lp-black-2k26-tabs-content"
    }
  },

  "tab-content.item#bf26-queridinhos-fem": {
    "title": "Conteúdo - Feminino",
    "children": [
      "flex-layout.row#bf26-queridinhos-fem-row"
    ],
    "props": {
      "tabId": "fem",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "flex-layout.row#bf26-queridinhos-fem-row": {
    "title": "Vitrine - Feminino",
    "children": [
      "image#bf26-queridinhos-fem-photo",
      "list-context.product-list#bf26-queridinhos-fem"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf-row", "lp-black-2k26-shelf-row--photo"]
    }
  },

  "image#bf26-queridinhos-fem-photo": {
    "title": "Imagem",
    "props": {
      "src": "assets/img/lp-black/queridinhos-banner.jpg",
      "alt": "",
      "blockClass": "lp-black-2k26-shelf-photo"
    }
  },

  "list-context.product-list#bf26-queridinhos-fem": {
    "title": "Vitrine - Feminino",
    "blocks": [
      "product-summary.shelf#new-shelf"
    ],
    "children": [
      "slider-layout#bf26-queridinhos-fem"
    ],
    "props": {
      "orderBy": "OrderByReleaseDateDESC",
      "collection": "",
      "category": "",
      "hideUnavailableItems": true,
      "maxItems": 12
    }
  },

  "slider-layout#bf26-queridinhos-fem": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "never",
      "blockClass": ["lp-black-2k26-shelf", "lp-black-2k26-arrows"]
    }
  },

  "tab-content.item#bf26-queridinhos-masc": {
    "title": "Conteúdo - Masculino",
    "children": [
      "flex-layout.row#bf26-queridinhos-masc-row"
    ],
    "props": {
      "tabId": "masc",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "flex-layout.row#bf26-queridinhos-masc-row": {
    "title": "Vitrine - Masculino",
    "children": [
      "image#bf26-queridinhos-masc-photo",
      "list-context.product-list#bf26-queridinhos-masc"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf-row", "lp-black-2k26-shelf-row--photo"]
    }
  },

  "image#bf26-queridinhos-masc-photo": {
    "title": "Imagem",
    "props": {
      "src": "assets/img/lp-black/queridinhos-banner.jpg",
      "alt": "",
      "blockClass": "lp-black-2k26-shelf-photo"
    }
  },

  "list-context.product-list#bf26-queridinhos-masc": {
    "title": "Vitrine - Masculino",
    "blocks": [
      "product-summary.shelf#new-shelf"
    ],
    "children": [
      "slider-layout#bf26-queridinhos-masc"
    ],
    "props": {
      "orderBy": "OrderByReleaseDateDESC",
      "collection": "",
      "category": "",
      "hideUnavailableItems": true,
      "maxItems": 12
    }
  },

  "slider-layout#bf26-queridinhos-masc": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "never",
      "blockClass": ["lp-black-2k26-shelf", "lp-black-2k26-arrows"]
    }
  }
}
