{
  "flex-layout.row#bf26-roupas-shelf": {
    "title": "Vitrine Roupas - Container",
    "children": [
      "flex-layout.col#bf26-roupas-shelf"
    ],
    "props": {
      "blockClass": [
        "lp-black-2k26-shelf", "lp-black-2k26-shelf--roupas"
      ],
      "fullWidth": true
    }
  },

  "flex-layout.col#bf26-roupas-shelf": {
    "title": "Vitrine Roupas - Coluna",
    "children": [
      "image#bf26-roupas-shelf-masc-photo-mobile",
      "rich-text#bf26-roupas-shelf-title",
      "rich-text#bf26-roupas-shelf-sub",
      "tab-layout#bf26-roupas-shelf"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf-col", "lp-black-2k26-shelf-col--photo"]
    }
  },

  "rich-text#bf26-roupas-shelf-title": {
    "title": "Título",
    "props": {
      "text": "## os queridinhos da black friday",
      "blockClass": ["lp-black-2k26-title", "lp-black-2k26-title--shelf"]
    }
  },

  "rich-text#bf26-roupas-shelf-sub": {
    "title": "Subtítulo",
    "props": {
      "text": "os modelos de tênis infantis mais procurados pelas famílias nesta semana",
      "blockClass": ["lp-black-2k26-text", "lp-black-2k26-text--sub"]
    }
  },

  "tab-layout#bf26-roupas-shelf": {
    "children": ["tab-list#bf26-roupas-shelf", "tab-content#bf26-roupas-shelf"],
    "props": {
      "defaultActiveTabId": "fem",
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list#bf26-roupas-shelf": {
    "title": "Tab - Botões",
    "children": ["tab-list.item#bf26-roupas-shelf-fem", "tab-list.item#bf26-roupas-shelf-masc"],
    "props": {
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list.item#bf26-roupas-shelf-fem": {
    "title": "Tab - Feminino",
    "props": {
      "tabId": "fem",
      "label": "feminino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-list.item#bf26-roupas-shelf-masc": {
    "title": "Tab - Masculino",
    "props": {
      "tabId": "masc",
      "label": "masculino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-content#bf26-roupas-shelf": {
    "title": "Tab - Conteúdo",
    "children": [
      "tab-content.item#bf26-roupas-shelf-fem",
      "tab-content.item#bf26-roupas-shelf-masc"
    ],
    "props": {
      "blockClass": "lp-black-2k26-tabs-content"
    }
  },

  "tab-content.item#bf26-roupas-shelf-fem": {
    "title": "Conteúdo - Feminino",
    "children": [
      "flex-layout.row#bf26-roupas-shelf-fem-row",
      "custom-progress-bar"
    ],
    "props": {
      "tabId": "fem",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "flex-layout.row#bf26-roupas-shelf-fem-row": {
    "title": "Vitrine - Feminino",
    "children": [
      "image#bf26-roupas-shelf-fem-photo",
      "list-context.product-list#bf26-roupas-shelf-fem"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf-row", "lp-black-2k26-shelf-row--photo"]
    }
  },

  "image#bf26-roupas-shelf-fem-photo": {
    "title": "Imagem",
    "props": {
      "src": "assets/img/lp-black/bf26-roupas-shelf-desktop.jpg",
      "alt": "",
      "blockClass": "lp-black-2k26-shelf-photo"
    }
  },

  "list-context.product-list#bf26-roupas-shelf-fem": {
    "title": "Vitrine - Feminino",
    "blocks": [
      "product-summary.shelf#product-category"
    ],
    "children": [
      "slider-layout#bf26-roupas-shelf"
    ],
    "props": {
      "orderBy": "OrderByReleaseDateDESC",
      "collection": "",
      "category": "",
      "hideUnavailableItems": true,
      "maxItems": 12
    }
  },

  "tab-content.item#bf26-roupas-shelf-masc": {
    "title": "Conteúdo - Masculino",
    "children": [
      "flex-layout.row#bf26-roupas-shelf-masc-row",
      "custom-progress-bar"
    ],
    "props": {
      "tabId": "masc",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "flex-layout.row#bf26-roupas-shelf-masc-row": {
    "title": "Vitrine - Masculino",
    "children": [
      "image#bf26-roupas-shelf-masc-photo",
      "list-context.product-list#bf26-roupas-shelf-masc"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf-row", "lp-black-2k26-shelf-row--photo"],
      "preventVerticalStretch": true
    }
  },

  "image#bf26-roupas-shelf-masc-photo": {
    "title": "Imagem",
    "props": {
      "src": "assets/img/lp-black/bf26-roupas-shelf-desktop.jpg",
      "alt": "",
      "blockClass": "lp-black-2k26-shelf-photo"
    }
  },

  "image#bf26-roupas-shelf-masc-photo-mobile": {
    "title": "Imagem",
    "props": {
      "src": "assets/img/lp-black/bf26-roupas-shelf-desktop.jpg",
      "alt": "",
      "blockClass": [ "lp-black-2k26-shelf-photo--mobile"]
    }
  },

  "list-context.product-list#bf26-roupas-shelf-masc": {
    "title": "Vitrine - Masculino",
    "blocks": [
      "product-summary.shelf#product-category"
    ],
    "children": [
      "slider-layout#bf26-roupas-shelf"
    ],
    "props": {
      "orderBy": "OrderByReleaseDateDESC",
      "collection": "",
      "category": "",
      "hideUnavailableItems": true,
      "maxItems": 12
    }
  },

  "slider-layout#bf26-roupas-shelf": {
    "props": {
      "itemsPerPage": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      },
      "centerMode": {
        "desktop": "disabled",
        "tablet": "disabled",
         "phone": "to-the-left"
      },
      "centerModeSlidesGap": 0,
      "infinite": false,
      "showNavigationArrows": "always",
      "showPaginationDots": "mobileOnly",
      "blockClass": ["lp-black-2k26-shelf", "lp-black-2k26-arrows"]
    }
  }
}
