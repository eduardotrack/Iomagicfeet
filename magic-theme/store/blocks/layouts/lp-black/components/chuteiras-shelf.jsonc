{
  "experimental__visibility-layout#bf26-chuteiras-shelf": {
    "title": "Vitrine Chuteiras - On/Off",
    "children": [
      "flex-layout.row#bf26-chuteiras-shelf"
    ],
    "props": {
      "visible": false
    }
  },

  "flex-layout.row#bf26-chuteiras-shelf": {
    "title": "Vitrine Chuteiras - Container",
    "children": [
      "flex-layout.col#bf26-chuteiras-shelf"
    ],
    "props": {
      "blockClass": [
        "lp-black-2k26-shelf"
      ],
      "fullWidth": true
    }
  },

  "flex-layout.col#bf26-chuteiras-shelf": {
    "title": "Vitrine Chuteiras - Coluna",
    "children": [
      "rich-text#bf26-chuteiras-shelf-title",
      "rich-text#bf26-chuteiras-shelf-sub",
      "tab-layout#bf26-chuteiras-shelf"
    ],
    "props": {
      "blockClass": "lp-black-2k26-shelf-col"
    }
  },

  "rich-text#bf26-chuteiras-shelf-title": {
    "title": "Título",
    "props": {
      "text": "## chuteiras infantis femininas em destaque",
      "blockClass": ["lp-black-2k26-title", "lp-black-2k26-title--shelf"]
    }
  },

  "rich-text#bf26-chuteiras-shelf-sub": {
    "title": "Subtítulo",
    "props": {
      "text": "selecione a categoria acima e navegue pelos modelos com descontos especiais para o treino, o jogo e a rotina do seu filho ou filha.",
      "blockClass": ["lp-black-2k26-text", "lp-black-2k26-text--sub"]
    }
  },

  "tab-layout#bf26-chuteiras-shelf": {
    "children": ["tab-list#bf26-chuteiras-shelf", "tab-content#bf26-chuteiras-shelf"],
    "props": {
      "defaultActiveTabId": "fem",
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list#bf26-chuteiras-shelf": {
    "title": "Tab - Botões",
    "children": [
      "tab-list.item#bf26-chuteiras-shelf-fem",
      "tab-list.item#bf26-chuteiras-shelf-masc"
    ],
    "props": {
      "blockClass": "lp-black-2k26-tabs"
    }
  },

  "tab-list.item#bf26-chuteiras-shelf-fem": {
    "title": "Tab - Feminino",
    "props": {
      "tabId": "fem",
      "label": "feminino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-list.item#bf26-chuteiras-shelf-masc": {
    "title": "Tab - Masculino",
    "props": {
      "tabId": "masc",
      "label": "masculino",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "tab-content#bf26-chuteiras-shelf": {
    "title": "Tab - Conteúdo",
    "children": [
      "tab-content.item#bf26-chuteiras-shelf-fem",
      "tab-content.item#bf26-chuteiras-shelf-masc"
    ],
    "props": {
      "blockClass": "lp-black-2k26-tabs-content"
    }
  },

  "tab-content.item#bf26-chuteiras-shelf-fem": {
    "title": "Conteúdo - Feminino",
    "children": [
      "flex-layout.row#bf26-chuteiras-shelf-fem-row"
    ],
    "props": {
      "tabId": "fem",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "flex-layout.row#bf26-chuteiras-shelf-fem-row": {
    "title": "Vitrine - Feminino",
    "children": [
      "image#bf26-chuteiras-shelf-fem-photo",
      "list-context.product-list#bf26-chuteiras-shelf-fem"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf-row", "lp-black-2k26-shelf-row--photo"]
    }
  },

  "image#bf26-chuteiras-shelf-fem-photo": {
    "title": "Imagem",
    "props": {
      "src": "https://placehold.co/600x700",
      "alt": "",
      "blockClass": "lp-black-2k26-shelf-photo"
    }
  },

  "list-context.product-list#bf26-chuteiras-shelf-fem": {
    "title": "Vitrine - Feminino",
    "blocks": [
      "product-summary.shelf#new-shelf"
    ],
    "children": [
      "slider-layout#bf26-chuteiras-shelf-fem"
    ],
    "props": {
      "orderBy": "OrderByReleaseDateDESC",
      "collection": "",
      "category": "",
      "hideUnavailableItems": true,
      "maxItems": 12
    }
  },

  "slider-layout#bf26-chuteiras-shelf-fem": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "never",
      "blockClass": ["lp-black-2k26-shelf", "lp-black-2k26-arrows"]
    }
  },

  "tab-content.item#bf26-chuteiras-shelf-masc": {
    "title": "Conteúdo - Masculino",
    "children": [
      "flex-layout.row#bf26-chuteiras-shelf-masc-row"
    ],
    "props": {
      "tabId": "masc",
      "blockClass": "lp-black-2k26-tab"
    }
  },

  "flex-layout.row#bf26-chuteiras-shelf-masc-row": {
    "title": "Vitrine - Masculino",
    "children": [
      "image#bf26-chuteiras-shelf-masc-photo",
      "list-context.product-list#bf26-chuteiras-shelf-masc"
    ],
    "props": {
      "blockClass": ["lp-black-2k26-shelf-row", "lp-black-2k26-shelf-row--photo"]
    }
  },

  "image#bf26-chuteiras-shelf-masc-photo": {
    "title": "Imagem",
    "props": {
      "src": "https://placehold.co/600x700",
      "alt": "",
      "blockClass": "lp-black-2k26-shelf-photo"
    }
  },

  "list-context.product-list#bf26-chuteiras-shelf-masc": {
    "title": "Vitrine - Masculino",
    "blocks": [
      "product-summary.shelf#new-shelf"
    ],
    "children": [
      "slider-layout#bf26-chuteiras-shelf-masc"
    ],
    "props": {
      "orderBy": "OrderByReleaseDateDESC",
      "collection": "",
      "category": "",
      "hideUnavailableItems": true,
      "maxItems": 12
    }
  },

  "slider-layout#bf26-chuteiras-shelf-masc": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 2
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "never",
      "blockClass": ["lp-black-2k26-shelf", "lp-black-2k26-arrows"]
    }
  }
}
